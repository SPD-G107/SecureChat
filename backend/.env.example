# Backend Server Environment Variables
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=securechat

# JWT / Session Secrets (Use a 64+ char random string in production)
JWT_SECRET=insecure_dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Provisioning (Optional: Set in private .env, never commit passwords to Git)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS
CORS_ORIGIN=http://localhost:3000
